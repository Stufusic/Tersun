class Host {
    pub dummy: int;

    def mouse_get_x(self) -> int {
        return 0;
    }
    def mouse_get_y(self) -> int {
        return 0;
    }
    def mouse_get_btn(self) -> int {
        return 99;
    }
    def is_mouse_down(self, btn: int) -> bool {
        return false;
    }
    def mouse_move(self, x: int, y: int) {
    }
    def mouse_click(self, btn: int, x: int, y: int) {
    }
    def syscall(self, id: int, a1: int, a2: int, a3: int) -> int {
