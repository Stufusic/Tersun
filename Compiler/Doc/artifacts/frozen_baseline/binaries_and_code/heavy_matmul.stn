// ============================================================================
// Heavy Workload H2: Matrix Multiplication (N = 100, Flat 1D Array)
// Tests: 1,000,000 multiply-accumulate operations, cache line traversal, array indexing
// ============================================================================

fn main() {
    let t0 = time_now_us();
    let n = 100;
    let size = n * n; // 10,000 elements

    // Initialize flat arrays A and B
    let A = [0, 0, 0, 0];
    let B = [0, 0, 0, 0];
    let C = [0, 0, 0, 0];

    for i in range(2500) {
        A.push(0); A.push(0); A.push(0); A.push(0);
        B.push(0); B.push(0); B.push(0); B.push(0);
        C.push(0); C.push(0); C.push(0); C.push(0);
    }

    for i in range(n) {
        for j in range(n) {
            let idx = i * n + j;
            A[idx] = (i + j) % 10;
            B[idx] = (i * 2 + j) % 10;
        }
    }

    // Cache-friendly i -> k -> j loop order
    for i in range(n) {
        for k in range(n) {
            let a_val = A[i * n + k];
            for j in range(n) {
                let c_idx = i * n + j;
                let b_idx = k * n + j;
                C[c_idx] += a_val * B[b_idx];
            }
        }
    }

    let checksum = 0;
    for i in range(size) {
        checksum += C[i];
        if (checksum > 1000000000) {
            checksum = checksum % 1000000000;
        }
    }

    let t1 = time_now_us();
    print("HEAVY_MATMUL checksum=");
    print(checksum);
    print(" time_us=");
    println(t1 - t0);
}
