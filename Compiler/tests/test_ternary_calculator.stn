// ============================================================================
//  TERSUN 1.0.3 TEST SUITE: TERNARY CALCULATOR & EXACT ALGEBRA ENGINE
//  tests/test_ternary_calculator.stn
// ============================================================================

import "Projects/ScientificLab/ternary_math_engine.stn";

fn main() -> int {
    println("===================================================================");
    println("  [Tersun 1.0.3] Balanced Ternary & Exact Algebraic Test Suite     ");
    println("===================================================================");

    // ------------------------------------------------------------------------
    // [Test 1/7] Decimal <-> Balanced Ternary Conversions
    // ------------------------------------------------------------------------
    println("\n[Test 1/7] Testing Decimal <-> Balanced Ternary Conversions...");

    let b0 = dec_to_bternary(0);
    assert_eq(b0, "0");
    assert_eq(bternary_to_dec("0"), 0);

    let b1 = dec_to_bternary(1);
    assert_eq(b1, "+");
    assert_eq(bternary_to_dec("+"), 1);

    let bn1 = dec_to_bternary(-1);
    assert_eq(bn1, "-");
    assert_eq(bternary_to_dec("-"), -1);

    let b2 = dec_to_bternary(2);
    assert_eq(b2, "+-");
    assert_eq(bternary_to_dec("+-"), 2);

    let b3 = dec_to_bternary(3);
    assert_eq(b3, "+0");
    assert_eq(bternary_to_dec("+0"), 3);

    let b13 = dec_to_bternary(13);
    assert_eq(b13, "+++");
    assert_eq(bternary_to_dec("+++"), 13);

    let b14 = dec_to_bternary(14);
    assert_eq(b14, "+---");
    assert_eq(bternary_to_dec("+---"), 14);

    let b42 = dec_to_bternary(42);
    assert_eq(b42, "+---0");
    assert_eq(bternary_to_dec("+---0"), 42);

    let bn42 = dec_to_bternary(-42);
    assert_eq(bn42, "-+++0");
    assert_eq(bternary_to_dec("-+++0"), -42);

    println("  -> PASSED: All 9 bidirectional decimal/ternary conversions verified!");

    // ------------------------------------------------------------------------
    // [Test 2/7] Tritwise Logic, Multi-Trit Operations & Weight
    // ------------------------------------------------------------------------
    println("\n[Test 2/7] Testing Tritwise Logic, Multi-Trit & Energy Weight...");

    let inv42 = trit_not_str("+---0");
    assert_eq(inv42, "-+++0");

    let w42 = trit_weight("+---0");
    assert_eq(w42, 4);

    let sum_t = trit_add_str("+---", "+-"); // 14 + 2 = 16
    let dec_sum = bternary_to_dec(sum_t);
    assert_eq(dec_sum, 16);

    let sub_t = trit_sub_str("+---", "+-"); // 14 - 2 = 12
    let dec_sub = bternary_to_dec(sub_t);
    assert_eq(dec_sub, 12);

    println("  -> PASSED: Tritwise NOT, ADD, SUB, and Hamming Weight verified!");

    // ------------------------------------------------------------------------
    // [Test 3/7] Exact Algebraic Powers in Q(sqrt(3))
    // ------------------------------------------------------------------------
    println("\n[Test 3/7] Testing Exact Algebraic Powers in Q(sqrt(3))...");

    let base: taf3 = [1, 1, 0]; // 1 + sqrt(3)
    let p2 = tafpu_power_exact(base, 2); // (1 + sqrt(3))^2 = 4 + 2*sqrt(3)
    assert_eq(p2, [4, 2, 0]);

    let p4 = tafpu_power_exact(base, 4); // (1 + sqrt(3))^4 = 28 + 16*sqrt(3)
    assert_eq(p4, [28, 16, 0]);

    let norm_p4 = tafpu_norm_exact(p4); // 28^2 - 3*16^2 = 784 - 768 = 16
    assert_eq(norm_p4, 16);

    println("  -> PASSED: Algebraic powers (1+sqrt(3))^2=[4,2,0] and (1+sqrt(3))^4=[28,16,0] verified!");

    // ------------------------------------------------------------------------
    // [Test 4/7] Exact Algebraic Inverses & Norms
    // ------------------------------------------------------------------------
    println("\n[Test 4/7] Testing Exact Algebraic Conjugates, Inverses & Norms...");

    let x: taf3 = [2, 1, 0]; // 2 + sqrt(3)
    let cx = tafpu_conjugate_exact(x);
    assert_eq(cx, [2, -1, 0]);

    let nx = tafpu_norm_exact(x);
    assert_eq(nx, 1);

    let inv_x = tafpu_inverse_exact(x); // (2 + sqrt(3))^-1 = 2 - sqrt(3)
    assert_eq(inv_x, [2, -1, 0]);

    let prod = x * inv_x;
    assert_eq(prod, [1, 0, 0]);

    println("  -> PASSED: Algebraic inverse (2+sqrt(3))^-1 = 2-sqrt(3) preserves 100% field ring!");

    // ------------------------------------------------------------------------
    // [Test 5/7] Exact CORDIC Trigonometry in Q(sqrt(3))
    // ------------------------------------------------------------------------
    println("\n[Test 5/7] Testing CORDIC Trigonometry at 0, 30, 60, 90 deg...");

    let rot0 = cordic_exact_angle(0);
    assert_eq(rot0.cos_val, [1, 0, 0]);
    assert_eq(rot0.sin_val, [0, 0, 0]);

    let rot30 = cordic_exact_angle(30);
    // cos(30)^2 + sin(30)^2 = (3 + 1) / 2^2 = 4 / 4 = 1
    let cos2_30 = rot30.cos_val * rot30.cos_val;
    let sin2_30 = rot30.sin_val * rot30.sin_val;
    let sum_sq_30 = cos2_30 + sin2_30;
    assert_eq(sum_sq_30, [4, 0, 0]);
    assert_eq(rot30.denom, 2);

    let rot90 = cordic_exact_angle(90);
    assert_eq(rot90.cos_val, [0, 0, 0]);
    assert_eq(rot90.sin_val, [1, 0, 0]);

    println("  -> PASSED: Exact CORDIC angle invariants (cos^2 + sin^2)/denom^2 = 1.0 verified with 0% drift!");

    // ------------------------------------------------------------------------
    // [Test 6/7] Exact Matrix 2x2 Spectral Analysis & Cayley-Hamilton
    // ------------------------------------------------------------------------
    println("\n[Test 6/7] Testing 2x2 Matrix Eigenvalues & Cayley-Hamilton Proof...");

    // Matrix M = [[2, 1], [3, 2]]
    let a11: taf3 = [2, 0, 0];
    let a12: taf3 = [1, 0, 0];
    let a21: taf3 = [3, 0, 0];
    let a22: taf3 = [2, 0, 0];

    let mat = analyze_matrix_2x2(a11, a12, a21, a22);
    assert_eq(mat.m_trace, [4, 0, 0]);
    assert_eq(mat.m_det, [1, 0, 0]);
    assert_eq(mat.has_exact_eigs, true);
    assert_eq(mat.eig1, [2, 1, 0]); // 2 + sqrt(3)
    assert_eq(mat.eig2, [2, -1, 0]); // 2 - sqrt(3)
    assert_eq(mat.cayley_hamilton_ok, true);

    println("  -> PASSED: Exact eigenvalues lambda1=[2,1,0], lambda2=[2,-1,0] and Cayley-Hamilton proved!");

    // ------------------------------------------------------------------------
    // [Test 7/7] Multi-Representation Expression Parser & Evaluator
    // ------------------------------------------------------------------------
    println("\n[Test 7/7] Testing Expression Evaluator...");

    let r1 = evaluate_math_expression("14 + 28");
    assert_eq(r1.dec_val, 42);
    assert_eq(r1.ternary_str, "+---0");

    let r2 = evaluate_math_expression("+++"); // 9 + 3 + 1 = 13
    assert_eq(r2.dec_val, 13);
    assert_eq(r2.ternary_str, "+++");

    let r3 = evaluate_math_expression("not +---0");
    assert_eq(r3.ternary_str, "-+++0");

    let r4 = evaluate_math_expression("norm 2,3"); // 4 - 27 = -23
    assert_eq(r4.dec_val, -23);

    let r5 = evaluate_math_expression("pow 1,1,4"); // (1 + sqrt(3))^4 = 28 + 16*sqrt(3)
    assert_eq(r5.taf_a, 28);
    assert_eq(r5.taf_b, 16);

    println("  -> PASSED: All user expression evaluations verified!");

    println("\n===================================================================");
    println("  ALL 7 TERNARY CALCULATOR & MATH ENGINE TESTS PASSED (100%)!       ");
    println("===================================================================");
    return 0;
}
