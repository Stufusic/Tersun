fn main() {
    // 1. Integer Modulo %
    assert_eq(17 % 5, 2);
    assert_eq(17 % -5, 2);
    assert_eq(-17 % 5, -2);
    assert_eq(-17 % -5, -2);
    assert_eq(20 % 5, 0);
    assert_eq(0 % 7, 0);

    // INT64_MIN % -1 guard test (hardware #DE protection)
    let min_i64 = -9223372036854775807 - 1;
    assert_eq(min_i64 % -1, 0);

    // 2. Integer Bitwise Operators
    assert_eq(60 & 13, 12);
    assert_eq(60 | 13, 61);
    assert_eq(60 ^ 13, 49);
    assert_eq(1 << 4, 16);
    assert_eq(5 << 2, 20);
    assert_eq(16 >> 4, 1);
    assert_eq(-16 >> 2, -4);

    // 3. Compound Assignments
    let m = 25;
    m %= 7;
    assert_eq(m, 4);

    let band = 15;
    band &= 6;
    assert_eq(band, 6);

    let bor = 8;
    bor |= 3;
    assert_eq(bor, 11);

    let bxor = 12;
    bxor ^= 10;
    assert_eq(bxor, 6);

    let bshl = 3;
    bshl <<= 3;
    assert_eq(bshl, 24);

    let bshr = 32;
    bshr >>= 2;
    assert_eq(bshr, 8);

    // 4. In-place loops using compound operators
    let sum = 0;
    for (let i = 0; i < 10; i += 1) {
        if (i % 2 == 0) {
            sum += i;
        }
    }
    // 0 + 2 + 4 + 6 + 8 = 20
    assert_eq(sum, 20);

    // 5. Monotonic High-Precision Timing
    let t1 = monotonic_now_us();
    let sum_delay = 0;
    for (let j = 0; j < 10000; j += 1) {
        sum_delay += j;
    }
    let t2 = monotonic_now_us();
    let t3 = time_now_us();

    // Monotonic invariant: non-decreasing
    assert_eq(t2 >= t1, true);
    assert_eq(t3 >= t2, true);

    println("PHASE2_OPERATORS_OK");
}
