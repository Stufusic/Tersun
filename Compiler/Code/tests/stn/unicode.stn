// Unicode string semantics: UTF-8 bytes under the hood, codepoint helpers.
import "mouse.stn";

fn main() {
    let s = "Tieng Viet";          // pure ASCII: unchanged behavior
    assert_eq(s.len(), 10);
    assert_eq(s.ulen(), 10);

    let v = "Tiếng Việt";
    assert_eq(v.len(), 14);          // bytes: tiếng=7 + space=1 + Việt=6
    assert_eq(v.ulen(), 10);         // codepoints: T i ế n g _ V i ệ t

    // uslice cuts by codepoint, not byte
    assert_eq(v.uslice(0, 5), "Tiếng");
    assert_eq(v.uslice(6, 4), "Việt");
    assert_eq(v.uindex(2), "ế");
    assert_eq(v.uindex(99), "");

    // chr now covers Vietnamese (was "" for anything >= 256)
    let h = Host();
    assert_eq(h.chr(65), "A");
    assert_eq(h.chr(7905), "ỡ");
    assert_eq(h.chr(7897), "ộ");

    // for-in over a string iterates codepoints
    let count = 0;
    let acc = "";
    for ch in "tiếng" {
        count += 1;
        acc = acc + ch;
    }
    assert_eq(count, 5);
    assert_eq(acc, "tiếng");

    // ASCII regression: byte and codepoint views agree
    let a = "hello";
    assert_eq(a.len(), a.ulen());
    assert_eq(a.uslice(1, 3), "ell");
    println("UNI_OK");
}
