{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Setun 2.0",
  "scopeName": "source.setun",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.setun",
          "match": "//.*$"
        },
        {
          "name": "comment.block.setun",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.setun",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.setun",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.interpolated.setun",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "punctuation.section.embedded.setun",
              "begin": "\\{",
              "end": "\\}"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.setun",
          "match": "\\b(fn|let|mut|struct|class|interface|trait|enum|match|branch3|async|await|comptime|return|if|else|while|loop|break|continue)\\b"
        },
        {
          "name": "keyword.other.branch3.arms.setun",
          "match": "\\b(negative|zero|positive)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.setun",
          "match": "\\b(taf3|tvec3|tquat|tryte|trit|int|float|double|string|bool|void)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.tafpu.setun",
          "match": "\\[\\s*-?\\d+\\s*,\\s*-?\\d+\\s*,\\s*-?\\d+\\s*\\]"
        },
        {
          "name": "constant.numeric.decimal.setun",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.setun",
          "match": "(=>|->|@|\\?\\.|\\?\\?|\\.\\.|\\+|-|\\*|/|==|!=|<=|>=|<|>|=|!|&|\\|)"
        }
      ]
    }
  }
}
