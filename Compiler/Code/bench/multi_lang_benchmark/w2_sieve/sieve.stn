fn main() {
    let t0 = time_now_us();
    let n = 100000;
    
    let flags = [0, 0, 0, 0];
    for i in range(25000) {
        flags.push(0); flags.push(0); flags.push(0); flags.push(0);
    }

    for p in range(2, 320) {
        if (flags[p] == 0) {
            let mult = p * p;
            while (mult <= n) {
                flags[mult] = 1;
                mult += p;
            }
        }
    }

    let count = 0;
    for i in range(2, n + 1) {
        if (flags[i] == 0) {
            count += 1;
        }
    }

    let t1 = time_now_us();
    print("W2_SIEVE checksum=");
    print(count);
    print(" time_us=");
    println(t1 - t0);
}
