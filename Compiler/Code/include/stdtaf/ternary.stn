// Tersun 1.0.3 Standard Ternary Algebra & Logic Library (stdtaf/ternary)

fn clamp_trit(val: int) -> trit {
    if val > 0 {
        return 1;
    } else if val < 0 {
        return -1;
    }
    return 0;
}

fn sign(val: int) -> trit {
    return clamp_trit(val);
}

fn kleene_and(a: trit, b: trit) -> trit {
    if a < b {
        return a;
    }
    return b;
}

fn kleene_or(a: trit, b: trit) -> trit {
    if a > b {
        return a;
    }
    return b;
}

fn ternary_mux(cond: trit, if_pos: int, if_zero: int, if_neg: int) -> int {
    branch (cond) {
        case +1: return if_pos;
        case  0: return if_zero;
        case -1: return if_neg;
    }
    return if_zero;
}

fn ternary_dot_accumulate(inputs: &[int], weights: &[trit], init_bias: int) -> int {
    return ternary_dot(inputs, weights, init_bias);
}
