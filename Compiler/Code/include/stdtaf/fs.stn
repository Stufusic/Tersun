// ----------------------------------------------------------------------------
// API CAP CAO: DOC / GHI / KIEM TRA FILE HE THONG
// ----------------------------------------------------------------------------

fn file_read(path: string) -> string {
    let host = HostFs();
    return host.fs_read(path);
}

fn file_write(path: string, content: string) -> int {
    let host = HostFs();
    return host.fs_write(path, content);
}

fn file_append(path: string, content: string) -> int {
    let host = HostFs();
    return host.fs_append(path, content);
}

fn file_exists(path: string) -> bool {
    let host = HostFs();
    return host.fs_exists(path);
}

fn file_size(path: string) -> int {
    let host = HostFs();
    return host.fs_size(path);
}

fn file_dialog_save(filter: string, def_ext: string) -> string {
    let host = HostFs();
    return host.file_dialog_save(filter, def_ext);
}

fn file_dialog_open(filter: string) -> string {
    let host = HostFs();
    return host.file_dialog_open(filter);
}
