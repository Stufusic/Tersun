class HostFs {
    pub dummy: int;

    def fs_read(self, path: string) -> string {
        return "";
    }
    def fs_write(self, path: string, content: string) -> int {
        return 0;
    }
    def fs_append(self, path: string, content: string) -> int {
        return 0;
    }
    def fs_exists(self, path: string) -> bool {
        return false;
    }
    def fs_size(self, path: string) -> int {
