// Example 1: TAFPU Q(sqrt(3)) Algebraic Arithmetic Demo
// Demonstrating exact zero-error arithmetic on Setun-70

println("=== Setun-70 TAFPU Algebraic Arithmetic Demo ===");

// 1. Exact algebraic multiplication: (1 + sqrt(3)) * (1 - sqrt(3)) = 1 - 3 = -2
let a: taf3 = [1, 1, 0];
let b: taf3 = [1, -1, 0];
let c = a * b;

print("Operand A: ");
println(a);
print("Operand B: ");
println(b);
print("Exact Product A * B (should be [-2, 0, 0] = -2): ");
println(c);

// 2. Addition with exponent alignment
let x: taf3 = [14, 25, 0];
let y: taf3 = [10, -5, 0];
let sum = x + y;
print("Sum of [14, 25, 0] + [10, -5, 0]: ");
println(sum);

// 3. Dynamic Encoding of real numbers (Algorithm 3.1)
let pi_real = 3.1415926535;
let pi_tafpu = encode_tafpu(pi_real);
print("Real PI 3.14159265 => Dynamic Encoded TAFPU: ");
println(pi_tafpu);

println("=== Demonstration completed successfully ===");
