// ============================================================================
// Tersun 1.0.2 Quantum Demonstration: 2-Bit to 1-Qubit & Superposition
// ============================================================================

fn main() -> int {
    // Pack 2-bit states into Qubits
    let q0: int = 0;  // 00_2 -> |0> Ground State
    let q1: int = 1;  // 01_2 -> |1> Excited State

    // Reversible quantum combination
    let entangled: int = q0 + q1;

    return entangled;
}
